/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SETUP DIALOGEX 0, 0, 369, 284
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TDengine ODBC Data Source Configuration"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "DSN",IDC_STC_DSN,18,19,15,8
    EDITTEXT        IDC_EDT_DSN,60,17,101,12,ES_AUTOHSCROLL
    GROUPBOX        "Connection type",IDC_STC_BACKEND,6,40,355,36
    CONTROL         "Websocket",IDC_RAD_TAOSWS,"Button",BS_AUTORADIOBUTTON | WS_GROUP,42,59,119,10
    CONTROL         "Native",IDC_RAD_TAOS,"Button",BS_AUTORADIOBUTTON,189,58,81,10
    GROUPBOX        "Server Info",IDC_STC_SERVER_INFO,6,82,354,42
    LTEXT           "Server Addr",IDC_STC_SERVER,18,103,38,8,NOT WS_VISIBLE
    EDITTEXT        IDC_EDT_SERVER,60,100,176,14,ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT           "Database",IDC_STC_DB,240,103,28,8
    EDITTEXT        IDC_EDT_DB,270,100,84,14,ES_AUTOHSCROLL
    LTEXT           "URL",IDC_STC_URL,18,103,14,8
    EDITTEXT        IDC_EDT_URL,60,100,176,14,ES_AUTOHSCROLL
    GROUPBOX        "Test Connection",IDC_STC_TEST,6,132,354,60
    LTEXT           "User",IDC_STC_UID,18,153,24,8
    EDITTEXT        IDC_EDT_USER,60,153,96,14,ES_AUTOHSCROLL
    LTEXT           "Password",IDC_STC_PWD,18,171,32,8
    EDITTEXT        IDC_EDT_PASS,60,171,96,14,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "Test Connection",IDC_BTN_TEST,269,168,85,14
    GROUPBOX        "Extra Info",IDC_GRP_EXTRA_INFO,6,200,354,50
    LTEXT           "Compatible Software",IDC_STC_COMPATBL_SOFTWARE,18,220,68,8
    COMBOBOX        IDC_COMBO_COMPATBL_SOFTWARE,90,220,96,14,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Enable Transmission Compression",IDC_CHK_COMPRESSION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,204,220,118,10
    PUSHBUTTON      "OK",IDOK,238,260,50,14,WS_GROUP
    DEFPUSHBUTTON   "Cancel",IDCANCEL,304,260,50,14
END



